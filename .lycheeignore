# Hosts that are checked manually because they block or time out for
# automated requests from outside Türkiye. Keep this list short and
# re-check these links by hand before each release.

# Server sends an incomplete TLS certificate chain. Browsers that fetch the
# missing intermediate open it fine; checked manually.
^https://verisistemi\.tbb\.org\.tr/
^https://www\.tobb\.org\.tr/

# Server only offers TLS cipher suites without forward secrecy, which the
# link checker does not support; checked manually.
^https://ekap\.kik\.gov\.tr/

# Times out or resets connections from CI runners outside Türkiye; checked
# manually from Türkiye.
^https://karararama\.yargitay\.gov\.tr/
